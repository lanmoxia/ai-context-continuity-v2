{
  "schema_version": 2,
  "default_policy": "deny",
  "context_pack_policy": "deny_all",
  "root_router": {
    "path": "AGENTS.md",
    "activation_phrases": [
      "启动55",
      "启动56",
      "启动开发",
      "启动审核",
      "【角色绑定】CODEX_56_FINAL_REVIEW",
      "【角色启动】启动开发",
      "【角色启动】启动审核"
    ]
  },
  "codex_router": {
    "path": "AGENTS.md",
    "activation_phrases": [
      "启动55",
      "启动56",
      "【角色绑定】CODEX_56_FINAL_REVIEW"
    ]
  },
  "antigravity_router": {
    "path": ".agents/rules/session-router.md",
    "activation_phrases": [
      "启动开发",
      "启动审核",
      "【角色启动】启动开发",
      "【角色启动】启动审核"
    ]
  },
  "external_artifacts": {
    "dispatches": {
      "root": ".continuity/session-control/dispatches",
      "append_only": true,
      "current_pointer": ".continuity/session-control/chatgpt/codex-5.5/HANDOFF.md",
      "read_policy": "exact_path_and_sha256_only",
      "directories": {
        "development": "development/**",
        "initial_review": "initial-review/**",
        "final_review": "final-review/**"
      }
    },
    "bootstrap_review_results": {
      "root": ".continuity/session-control/review-results",
      "append_only": true,
      "directories": {
        "gate_01": "gate-01/**",
        "gate_02": "gate-02/**",
        "gate_03": "gate-03/**",
        "task_final": "task-final/**"
      }
    }
  },
  "roles": {
    "codex-5.6": {
      "startup": ".continuity/session-control/chatgpt/codex-5.6/START.md",
      "allowed_role_files": [
        ".continuity/session-control/shared/COMMON_RULES.md",
        ".continuity/session-control/shared/WORKFLOW.md",
        ".continuity/session-control/shared/BOOTSTRAP_AND_SELF_HOSTING.md",
        ".continuity/session-control/chatgpt/codex-5.6/RULES.md",
        ".continuity/session-control/chatgpt/codex-5.6/OWNER_PREFERENCES.md",
        ".continuity/session-control/chatgpt/codex-5.6/PROJECT_BRIEF.md",
        ".continuity/session-control/chatgpt/codex-5.6/HANDOFF.md"
      ],
      "mode_files": {
        "architecture_design": [
          ".continuity/session-control/chatgpt/codex-5.6/OWNER_PREFERENCES.md",
          ".continuity/session-control/chatgpt/codex-5.6/PROJECT_BRIEF.md",
          ".continuity/session-control/chatgpt/codex-5.6/HANDOFF.md"
        ],
        "final_review": [
          ".continuity/session-control/chatgpt/codex-5.6/OWNER_PREFERENCES.md",
          ".continuity/session-control/chatgpt/codex-5.6/HANDOFF.md"
        ]
      },
      "conditional_paths": {
        "architecture_design_write": [
          ".continuity/session-control/dispatches/**",
          ".continuity/session-control/review-results/**"
        ],
        "final_review_read_exact": [
          ".continuity/session-control/dispatches/final-review/**"
        ],
        "final_review_write_exact": [
          ".continuity/session-control/review-results/gate-03/**",
          ".continuity/session-control/review-results/task-final/**"
        ]
      }
    },
    "codex-5.5": {
      "startup": ".continuity/session-control/chatgpt/codex-5.5/START.md",
      "allowed_role_files": [
        ".continuity/session-control/shared/COMMON_RULES.md",
        ".continuity/session-control/shared/WORKFLOW.md",
        ".continuity/session-control/shared/BOOTSTRAP_AND_SELF_HOSTING.md",
        ".continuity/session-control/chatgpt/codex-5.5/RULES.md",
        ".continuity/session-control/chatgpt/codex-5.5/COMMANDS.md",
        ".continuity/session-control/chatgpt/codex-5.5/HANDOFF.md"
      ],
      "conditional_paths": {
        "read_exact": [
          ".continuity/session-control/dispatches/**",
          ".continuity/session-control/review-results/gate-01/**",
          ".continuity/session-control/review-results/gate-03/**",
          ".continuity/session-control/review-results/task-final/**"
        ],
        "write_new": [
          ".continuity/session-control/dispatches/**",
          ".continuity/session-control/review-results/gate-02/**"
        ]
      }
    },
    "antigravity-development": {
      "startup": ".continuity/session-control/antigravity/development/START.md",
      "allowed_role_files": [
        ".continuity/session-control/shared/COMMON_RULES.md",
        ".continuity/session-control/shared/WORKFLOW.md",
        ".continuity/session-control/shared/BOOTSTRAP_AND_SELF_HOSTING.md",
        ".continuity/session-control/antigravity/development/RULES.md",
        ".continuity/session-control/antigravity/development/HANDOFF.md"
      ],
      "conditional_paths": {
        "read_exact": [
          ".continuity/session-control/dispatches/development/**"
        ],
        "write_exact": [
          ".continuity/session-control/antigravity/development/HANDOFF.md"
        ]
      }
    },
    "antigravity-initial-review": {
      "startup": ".continuity/session-control/antigravity/initial-review/START.md",
      "allowed_role_files": [
        ".continuity/session-control/shared/COMMON_RULES.md",
        ".continuity/session-control/shared/WORKFLOW.md",
        ".continuity/session-control/shared/BOOTSTRAP_AND_SELF_HOSTING.md",
        ".continuity/session-control/antigravity/initial-review/RULES.md",
        ".continuity/session-control/antigravity/initial-review/HANDOFF.md"
      ],
      "conditional_paths": {
        "read_exact": [
          ".continuity/session-control/dispatches/initial-review/**"
        ],
        "write_exact": [
          ".continuity/session-control/review-results/gate-01/**",
          ".continuity/session-control/antigravity/initial-review/HANDOFF.md"
        ]
      }
    }
  },
  "never_context_pack": [
    "AGENTS.md",
    ".agents/**",
    ".continuity/session-control/**"
  ]
}
