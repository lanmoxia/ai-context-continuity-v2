{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:continuity:schema:checkpoint:1",
  "title": "Continuity Checkpoint",
  "description": "Immutable lightweight save-point during development. Append-only, never overwritten. Stored in .continuity/checkpoints/CHECKPOINT-NNNN.json.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:continuity:schema:common:1#/$defs/schema_version" },
    "id": { "$ref": "urn:continuity:schema:common:1#/$defs/stable_id" },
    "task_id": { "$ref": "urn:continuity:schema:common:1#/$defs/stable_id" },
    "stage_id": { "$ref": "urn:continuity:schema:common:1#/$defs/stable_id" },
    "state_revision": { "type": "integer", "minimum": 0 },
    "writer_lease_id": { "type": ["string", "null"] },
    "completed_steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "in_progress_steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "changed_files": {
      "type": "array",
      "items": { "$ref": "urn:continuity:schema:common:1#/$defs/path_string" }
    },
    "check_summaries": {
      "type": "array",
      "items": { "$ref": "urn:continuity:schema:common:1#/$defs/check_summary" }
    },
    "known_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_fingerprint": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/source_fingerprint" },
        { "type": "null" }
      ]
    },
    "created_at": { "$ref": "urn:continuity:schema:common:1#/$defs/rfc3339_with_timezone" }
  },
  "required": [
    "schema_version", "id", "task_id", "stage_id", "state_revision",
    "writer_lease_id", "completed_steps", "in_progress_steps",
    "changed_files", "check_summaries", "known_risks", "source_fingerprint", "created_at"
  ],
  "additionalProperties": false
}
