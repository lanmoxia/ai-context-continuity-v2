{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:continuity:schema:common:1",
  "title": "Continuity Common Definitions",
  "description": "Shared definitions used across all Continuity entity schemas.",
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version; must be 1."
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{4,}$",
      "description": "Stable uppercase identifier with at least four decimal digits, e.g. TASK-0001."
    },
    "rfc3339_with_timezone": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "RFC 3339 timestamp that must include a timezone offset (Z or ±HH:MM)."
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex-encoded SHA-256 digest of a file's raw bytes."
    },
    "check_summary": {
      "type": "object",
      "description": "Summary of a single required check execution.",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
        "summary": { "type": "string" }
      },
      "required": ["id", "exit_code", "status"],
      "additionalProperties": false
    },
    "source_fingerprint_entry": {
      "type": "object",
      "description": "Per-file entry in a Source Fingerprint (path, size, content hash).",
      "properties": {
        "path": { "$ref": "urn:continuity:schema:common:1#/$defs/path_string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "urn:continuity:schema:common:1#/$defs/file_sha256" }
      },
      "required": ["path", "size_bytes", "sha256"],
      "additionalProperties": false
    },
    "source_fingerprint": {
      "type": "object",
      "description": "Source Fingerprint capturing state of the working tree at a point in time.",
      "properties": {
        "git_head": {
          "type": ["string", "null"],
          "description": "Current Git HEAD commit SHA, or null when Git is unavailable."
        },
        "staged_diff_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "unstaged_diff_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "untracked_files": {
          "type": "array",
          "items": { "$ref": "urn:continuity:schema:common:1#/$defs/source_fingerprint_entry" }
        },
        "captured_at": { "$ref": "urn:continuity:schema:common:1#/$defs/rfc3339_with_timezone" }
      },
      "required": ["git_head", "staged_diff_sha256", "unstaged_diff_sha256", "untracked_files", "captured_at"],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "description": "A single review finding.",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "location": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string" },
        "recommendation": { "type": "string" }
      },
      "required": ["id", "severity", "description"],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "description": "Approval record for a Work Order or other artifact.",
      "properties": {
        "approved_at": { "$ref": "urn:continuity:schema:common:1#/$defs/rfc3339_with_timezone" },
        "approved_by": { "type": "string", "minLength": 1 },
        "draft_sha256": { "$ref": "urn:continuity:schema:common:1#/$defs/file_sha256" }
      },
      "required": ["approved_at", "approved_by", "draft_sha256"],
      "additionalProperties": false
    },
    "check_argv_entry": {
      "type": "object",
      "description": "A single approved check command entry.",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "cwd": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_path_string" },
        "timeout_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "allowed_exit_codes": {
          "type": "array",
          "items": { "type": "integer" }
        }
      },
      "required": ["id", "argv", "cwd", "timeout_seconds", "allowed_exit_codes"],
      "additionalProperties": false
    },
    "path_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!^[a-zA-Z]:)(?!.*[/\\\\]\\.\\.([/\\\\]|$))(?!.*[/\\\\]\\.([/\\\\]|$))(?!^\\.\\.([/\\\\]|$))(?!^\\.([/\\\\]|$))[^/\\\\]+([/\\\\][^/\\\\]+)*$",
      "description": "A non-empty relative path string, rejecting absolute paths, drive letters, and relative traversal segments."
    },
    "project_id": {
      "type": "string",
      "pattern": "^PROJECT-[0-9]{4,}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4,}$"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^STAGE-[0-9]{4,}$"
    },
    "work_order_id": {
      "type": "string",
      "pattern": "^WORK-[0-9]{4,}$"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^CHECKPOINT-[0-9]{4,}$"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^HANDOFF-[0-9]{4,}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EVIDENCE-[0-9]{4,}$"
    },
    "context_pack_id": {
      "type": "string",
      "pattern": "^CTX-[0-9]{4,}$"
    },
    "review_pack_id": {
      "type": "string",
      "pattern": "^PACK-[0-9]{4,}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^REVIEW-[0-9]{4,}$"
    },
    "nullable_stable_id": {
      "description": "A stable ID or null.",
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/stable_id" },
        { "type": "null" }
      ]
    },
    "nullable_project_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/project_id" },
        { "type": "null" }
      ]
    },
    "nullable_task_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/task_id" },
        { "type": "null" }
      ]
    },
    "nullable_stage_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/stage_id" },
        { "type": "null" }
      ]
    },
    "nullable_work_order_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/work_order_id" },
        { "type": "null" }
      ]
    },
    "nullable_checkpoint_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/checkpoint_id" },
        { "type": "null" }
      ]
    },
    "nullable_handoff_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/handoff_id" },
        { "type": "null" }
      ]
    },
    "nullable_evidence_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/evidence_id" },
        { "type": "null" }
      ]
    },
    "nullable_context_pack_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/context_pack_id" },
        { "type": "null" }
      ]
    },
    "nullable_review_pack_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/review_pack_id" },
        { "type": "null" }
      ]
    },
    "nullable_review_id": {
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/review_id" },
        { "type": "null" }
      ]
    },
    "nullable_file_sha256": {
      "description": "A SHA-256 digest or null.",
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/file_sha256" },
        { "type": "null" }
      ]
    },
    "nullable_path_string": {
      "description": "A path string or null.",
      "anyOf": [
        { "$ref": "urn:continuity:schema:common:1#/$defs/path_string" },
        { "type": "null" }
      ]
    }
  }
}
