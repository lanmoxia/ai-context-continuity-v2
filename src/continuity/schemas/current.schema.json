{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:continuity:schema:current:1",
  "title": "Continuity Current Pointer",
  "description": "Current state pointer stored in .continuity/current.json. Contains only pointers, not full entity text.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:continuity:schema:common:1#/$defs/schema_version" },
    "state_revision": { "type": "integer", "minimum": 0 },
    "active_task_id": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_stable_id" },
    "active_stage_id": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_stable_id" },
    "active_work_order_id": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_stable_id" },
    "latest_checkpoint_id": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_stable_id" },
    "latest_handoff_id": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_stable_id" },
    "latest_context_id": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_stable_id" },
    "active_review_pack_id": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_stable_id" },
    "latest_transfer_id": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_stable_id" },
    "task_final_review_pack_id": { "$ref": "urn:continuity:schema:common:1#/$defs/nullable_stable_id" },
    "active_task_branch": { "type": ["string", "null"] },
    "updated_at": { "$ref": "urn:continuity:schema:common:1#/$defs/rfc3339_with_timezone" }
  },
  "required": [
    "schema_version", "state_revision", "active_task_id", "active_stage_id",
    "active_work_order_id", "latest_checkpoint_id", "latest_handoff_id",
    "latest_context_id", "active_review_pack_id", "latest_transfer_id",
    "task_final_review_pack_id", "active_task_branch", "updated_at"
  ],
  "additionalProperties": false
}
