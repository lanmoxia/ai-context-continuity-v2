{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:continuity:schema:review-decision:1",
  "title": "Continuity Review Gate Decision",
  "description": "A single Gate decision bound to a specific Review Pack manifest hash. Stored in .continuity/reviews/PACK-NNNN/decisions/.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:continuity:schema:common:1#/$defs/schema_version" },
    "review_id": { "$ref": "urn:continuity:schema:common:1#/$defs/stable_id" },
    "pack_id": { "$ref": "urn:continuity:schema:common:1#/$defs/stable_id" },
    "manifest_sha256": { "$ref": "urn:continuity:schema:common:1#/$defs/file_sha256" },
    "gate_id": { "type": "string", "minLength": 1 },
    "round": { "type": "integer", "minimum": 1, "description": "Generic review round number, not tied to any specific client." },
    "verdict": {
      "type": "string",
      "enum": ["approve", "changes_requested", "needs_human"]
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "urn:continuity:schema:common:1#/$defs/finding" }
    },
    "created_at": { "$ref": "urn:continuity:schema:common:1#/$defs/rfc3339_with_timezone" }
  },
  "required": [
    "schema_version", "review_id", "pack_id", "manifest_sha256",
    "gate_id", "round", "verdict", "findings", "created_at"
  ],
  "additionalProperties": false
}
